# Reference only — deploy.sh does not install this automatically.
# Make sure a block like this exists in prod's Caddy config
# (e.g. /etc/caddy/Caddyfile), then `systemctl reload caddy` after adding it.
#
# The log block keeps a JSON access log of every request, rolled by size and
# age. /var/log/caddy must exist and be owned by the caddy user.
mrwr.dev {
	reverse_proxy localhost:3000

	log {
		output file /var/log/caddy/mrwr.dev.access.log {
			roll_size 20MiB
			roll_keep 5
			roll_keep_for 720h
		}
		format json
	}
}
