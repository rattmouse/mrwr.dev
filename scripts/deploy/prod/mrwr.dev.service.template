[Unit]
Description=mrwr.dev express server
After=network.target

[Service]
WorkingDirectory=__APP_DIR__/current
ExecStart=/usr/bin/bash __APP_DIR__/current/start.sh
Restart=always
RestartSec=5
Environment=NODE_ENV=production
# Durable search-log archive, kept outside __APP_DIR__/current so it survives
# release swaps and pruning (issue #55).
Environment=SEARCH_LOG_FILE=__APP_DIR__/shared/search-log.ndjson
# Optional search-session notifier config (SEARCH_NOTIFY_KIND=telegram|ntfy|
# webhook plus its secrets). Under /etc so SELinux labels it something PID 1
# may read (a file under __APP_DIR__/ i.e. /root inherits admin_home_t, which
# init_t cannot read — the "-" then hides the failure and the notifier stays
# silently unconfigured). Never committed; the leading "-" makes it optional.
EnvironmentFile=-/etc/mrwr.dev/notify.env
User=root
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
