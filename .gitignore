# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production (old build-VM pipeline, retired — see scripts/deploy/)
/build

# local deploy staging + machine-local deploy config (see scripts/deploy/)
/.deploy/
scripts/deploy/deploy.config.sh

# misc
.DS_Store
*.pem
__pycache__/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
src/data/issues.json
src/data/search-history.json
# build-time GitHub enrichment for the Projects window (see scripts/content/refresh-projects.sh)
src/data/projects.json
/public/projects/remote/
/public/collections

# durable search-log archive written by server.js at runtime (issue #55)
/search-log.ndjson*

# local triage state for scripts/content/search-to-issue.sh (machine-local)
scripts/content/.search-triage-state.json
